# Copy this file to .env and fill in values before running the server.
# Never commit .env. On Render, set these under the service's Environment tab.

# Secret used to sign session cookies: a random string of at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when NODE_ENV=production (the server will not start without it).
SESSION_SECRET=

# The single login account. Store only the bcrypt hash, never the password.
# Generate the hash with:  npm run hash-password
# In .env, wrap the hash in single quotes because it contains $ characters.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Port the server listens on (default: 3000)
PORT=3000

# Path to the SQLite database file (default: clubz.db in the project root)
DB_PATH=./clubz.db

# Set to "production" in a deployed environment; controls secure cookies
NODE_ENV=development
